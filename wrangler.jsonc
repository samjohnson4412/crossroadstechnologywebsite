{
  // Cloudflare Workers static-assets config.
  //
  // There is no Worker script — this serves the built site in dist/ directly.
  // Cloudflare Workers Builds runs the build command, then `npx wrangler deploy`
  // uploads whatever is in the assets directory below.
  //
  // dist/_headers and dist/_redirects are picked up automatically.
  "name": "crossroads-technology",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html for unknown paths instead of a bare Cloudflare error.
    "not_found_handling": "404-page"
  }
}
